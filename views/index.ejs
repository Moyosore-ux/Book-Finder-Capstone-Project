<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Book Finder</title>
  <link rel="stylesheet" href="/styles.css" />
</head>
<body>
  <header>
    <h1>Book Finder</h1>
    <p>Search any title or author.</p>
    <form action="/search" method="POST">
      <input type="text" name="query" placeholder="e.g. Chimamanda Adichie" value="<%= query %>" />
      <button type="submit">Search</button>
    </form>
  </header>

  <main>
    <% if (error) { %>
      <p class="error"><%= error %></p>
    <% } %>

    <% if (books) { %>
      <div class="grid">
        <% books.forEach(book => { %>
          <article class="card">
            <% if (book.cover) { %>
              <img src="<%= book.cover %>" alt="Cover of <%= book.title %>" />
            <% } else { %>
              <div class="no-cover">No cover</div>
            <% } %>
            <h2><%= book.title %></h2>
            <p><%= book.author %></p>
            <small>First published: <%= book.year %></small>
          </article>
        <% }) %>
      </div>
    <% } %>
  </main>
</body>
</html>